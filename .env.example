# ============================================================
# 微旅途后端 · 环境变量模板
# ------------------------------------------------------------
# 用法：
#   cp .env.example .env        # 然后按需填写
#   docker compose --env-file .env ...   # 或由 systemd EnvironmentFile 加载
#
# ⚠️ .env 已在 .gitignore 中，切勿提交含真实密钥的 .env。
# ============================================================

# ---------- 运行档位 ----------
# 组合原则：能力 profile（mysql / redis / https）与档位 profile（prod）正交
#   本地开发（零依赖）  : （留空）→ 文件型 H2 + 内存吊销 + HTTP
#   本地开发（完整栈）  : mysql,redis
#   生产（推荐）        : prod,mysql,redis,https
SPRING_PROFILES_ACTIVE=

# 服务监听端口（App 端 AuthService 默认连 3000）
SERVER_PORT=3000

# ---------- 数据库（mysql profile 生效）----------
# ⚠️ 容器编排下 DB_HOST 必须是**服务名**（如 mysql），不能写 localhost
DB_HOST=localhost
DB_PORT=3306
# 生产务必使用独立业务账号，不要用 root
DB_NAME=microtrip
DB_USERNAME=microtrip
# 生成方式：openssl rand -base64 24
DB_PASSWORD=change-me-in-production
DB_USE_SSL=false
# 连接池：并发副本数 × DB_POOL_MAX 应小于 MySQL max_connections
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5
# 建表策略：首启 update（自动建表）→ 稳定后建议改 validate
JPA_DDL_AUTO=update

# ---------- Redis（redis profile 生效；不启用则用内存实现，单实例可用）----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
# 生成方式：openssl rand -base64 48
# ⚠️ 生产（prod profile）未设置本项将直接启动失败（fail-fast），这是刻意设计：
#    随机生成的密钥在多副本间不共享，重启即导致全部用户掉线。
JWT_SECRET=

# ---------- 安全开关 ----------
# 生产建议 true，配合 Nginx 转发 X-Forwarded-Proto 使用
REQUIRE_HTTPS=false
# App 原生请求不带 Origin，默认 *；若同时有 Web 端，改为具体域名
CORS_ORIGIN=*

# ---------- 限流（防登录爆破）----------
RATELIMIT_ENABLED=true
RATELIMIT_CAPACITY=60
RATELIMIT_WINDOW=60

# ---------- 管理员引导账号（留空则不自动创建）----------
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NICKNAME=超级管理员

# ---------- 拍照识物（留空则该接口返回 501 NOT_CONFIGURED）----------
# 可选：tencent | aliyun | baidu
VISION_PROVIDER=tencent
# 腾讯云图像分析 tiia
VISION_SECRET_ID=
VISION_SECRET_KEY=
VISION_REGION=ap-guangzhou
# 阿里云图像识别 imagerecog
ALIYUN_AK=
ALIYUN_SK=
ALIYUN_REGION=cn-shanghai
# 百度 AIP
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# ---------- 日志与监控 ----------
# 文件日志路径；容器内建议 /app/logs/app.log，宿主机部署建议 /var/log/microtrip/app.log
LOG_FILE=application.log
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
MGMT_ENDPOINTS=health,info,prometheus
# Actuator 指标端点（metrics / prometheus）的来源 IP 白名单。
#   默认 127.0.0.1,::1 = 仅本机，即只有同机 Prometheus 能拉取。
#   支持精确 IP 与 IPv4 CIDR：127.0.0.1,10.0.0.0/8,172.17.0.0/16
#   留空 = 谁都不放行（fail-closed）。
#   ⚠️ 不要写 0.0.0.0/0，那等于把 JVM/连接池/接口耗时数据公开。
ACTUATOR_ALLOW_LIST=127.0.0.1,::1

# ---------- JVM 参数（容器/脚本读取，非 Spring 配置）----------
# 容器内建议开启容器感知：-XX:MaxRAMPercentage=75 取代固定 -Xmx
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

# ---------- MySQL 容器（docker compose 使用）----------
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=microtrip
MYSQL_USER=microtrip
MYSQL_PASSWORD=change-me-in-production

# ---------- 镜像 ----------
APP_IMAGE=micro-trip-server:1.0.0
# 宿主机映射端口（生产经 Nginx 反代，通常只监听回环）
HOST_PORT=3000
