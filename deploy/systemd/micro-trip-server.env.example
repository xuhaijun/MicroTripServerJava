# ============================================================
# systemd EnvironmentFile 模板（服务器裸机部署）
# ------------------------------------------------------------
# 安装：
#   sudo mkdir -p /etc/microtrip
#   sudo cp deploy/systemd/micro-trip-server.env.example /etc/microtrip/server.env
#   sudo chmod 600 /etc/microtrip/server.env && sudo chown root:root /etc/microtrip/server.env
#   sudo vim /etc/microtrip/server.env
#
# 语法：systemd 的 EnvironmentFile，KEY=VALUE 每行一条，
#       不要写 export，不要用 $(...) 命令替换（不展开）。
# ============================================================

# ---------- 运行档位 ----------
# 裸机 + 前置 Nginx 终止 TLS 时用这组：
#   prod   —— 优雅停机 / Actuator 收敛 / JWT 强制外部化
#   mysql  —— 切 MySQL
#   redis  —— 令牌吊销跨实例共享
#   https  —— 强制 HTTPS + 信任 Nginx 的 X-Forwarded-Proto
# 若暂未配 Nginx/TLS，去掉 https 并把 REQUIRE_HTTPS 设为 false
SPRING_PROFILES_ACTIVE=prod,mysql,redis,https

# ---------- 监听 ----------
SERVER_PORT=3000
# Actuator 指标端点来源白名单（metrics / prometheus）；默认仅本机回环。
# 同机 Prometheus 拉取无需改动；若采集器在别的机器，把其 IP/CIDR 加进来。
ACTUATOR_ALLOW_LIST=127.0.0.1,::1
MGMT_ENDPOINTS=health,info,prometheus

# ---------- 数据库 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=microtrip
DB_USERNAME=microtrip
# 生成：openssl rand -base64 24
DB_PASSWORD=
DB_USE_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5
# 首次部署用 update 自动建表，确认稳定后建议改 validate
JPA_DDL_AUTO=update

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT（prod profile 下留空将拒绝启动）----------
# 生成：openssl rand -base64 48
JWT_SECRET=

# ---------- 安全 ----------
REQUIRE_HTTPS=true
CORS_ORIGIN=*

# ---------- 限流 ----------
RATELIMIT_ENABLED=true
RATELIMIT_CAPACITY=60
RATELIMIT_WINDOW=60

# ---------- 管理员引导账号（留空不创建）----------
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NICKNAME=超级管理员

# ---------- 拍照识物 ----------
VISION_PROVIDER=tencent
VISION_SECRET_ID=
VISION_SECRET_KEY=
VISION_REGION=ap-guangzhou
ALIYUN_AK=
ALIYUN_SK=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# ---------- 日志 ----------
LOG_FILE=/var/log/microtrip/app.log
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# ---------- JVM ----------
# systemd 单元里已固化主要参数，此处仅作补充覆盖
JAVA_OPTS_EXTRA=
